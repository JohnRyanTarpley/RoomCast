# Virtual environment (created by "Run RoomCast.bat" on first run)
.venv/
runtime/
venv/
env/

# Python bytecode / caches
__pycache__/
*.py[cod]
*.pyo

# Packaging / build output (e.g. PyInstaller, setuptools)
build/
dist/
tools/
*.spec
*.egg-info/
.eggs/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Logs and local audio captures
*.log
*.wav

# Editor / IDE
.vscode/
.idea/
*.swp

# OS junk
Thumbs.db
desktop.ini
.DS_Store
